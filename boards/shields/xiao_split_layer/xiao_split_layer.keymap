#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {

        /* ---------------- numbers ---------------- */

        morph_n0: morph_n0 { /* 0 ) (shift-N9) */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N0";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp N9>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n1: morph_n1 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N1";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp N1>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n2: morph_n2 { /* 2 @ (shift-LBKT) */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N2";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n3: morph_n3 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N3";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp N3>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n4: morph_n4 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N4";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp N4>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n5: morph_n5 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N5";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp N5>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n6: morph_n6 { /* 6 ^ (shift-EQUAL) */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N6";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n7: morph_n7 { /* 7 & (shift-N6) */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N7";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp N6>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n8: morph_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N8";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp N8>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n9: morph_n9 { /* 0 ((shift-N8) */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N9";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp N8>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        /* ---------------- symbols ---------------- */

        morph_minus: morph_minus {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_MINUS";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp MINUS>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_lbkt: morph_lbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_LBKT";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp LBKT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_rbkt: morph_rbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_RBKT";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp RBKT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_semi: morph_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_SEMI";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp SEMI>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        /* ---------------- unique ---------------- */

        u_equal: u_equal {
            compatible = "zmk,behavior-mod-morph";
            label = "u_EQUAL";
            #binding-cells = <0>;
            /* JISで + を出すには Shift+; */
            bindings = <&kp EQUAL>, <&kp SEMI>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_plus: u_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "u_PLUS";
            #binding-cells = <0>;
            /* + を確実に出す */
            bindings = <&kp SEMI>, <&kp SEMI>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_fslh: u_fslh {
            compatible = "zmk,behavior-mod-morph";
            label = "u_FSLH";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp FSLH>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_enter: u_enter {
            compatible = "zmk,behavior-mod-morph";
            label = "u_ENTER";
            #binding-cells = <0>;
            bindings = <&kp ENTER>, <&kp ENTER>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_dot: u_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "u_DOT";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp DOT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_lpar: u_lpar {
            compatible = "zmk,behavior-mod-morph";
            label = "u_LPAR";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp LPAR>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_rpar: u_rpar {
            compatible = "zmk,behavior-mod-morph";
            label = "u_RPAR";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp RPAR>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

    };
};
