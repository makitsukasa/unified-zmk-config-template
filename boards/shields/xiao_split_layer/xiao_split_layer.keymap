#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {

        /* ---------------- numbers ---------------- */

        morph_n0: morph_n0 { /* 0 ) */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N0";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp LS(N9)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n1: morph_n1 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N1";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp LS(N1)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n2: morph_n2 { /* 2 @ */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N2";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n3: morph_n3 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N3";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp LS(N3)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n4: morph_n4 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N4";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp LS(N4)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n5: morph_n5 {
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N5";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp LS(N5)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n6: morph_n6 { /* 6 ^ */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N6";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n7: morph_n7 { /* 7 & */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N7";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp LS(N6)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n8: morph_n8 { /* 8 * */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N8";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp LS(APOS)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_n9: morph_n9 { /* 9 ( */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_N9";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp LS(N8)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        /* ---------------- symbols ---------------- */

        morph_minus: morph_minus { /* - _ */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_MINUS";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT_RO)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_lbkt: morph_lbkt { /* [ { */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_LBKT";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp LS(RBKT)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_rbkt: morph_rbkt { /* ] } */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_RBKT";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp LS(BSLH)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_semi: morph_semi { /* ; : */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_SEMI";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp APOS>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        /* ---------------- unique ---------------- */

        u_equal: u_equal { /* = ` */
            compatible = "zmk,behavior-mod-morph";
            label = "u_EQUAL";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp LS(LBKT)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_plus: u_plus { /* + ~ */
            compatible = "zmk,behavior-mod-morph";
            label = "u_PLUS";
            #binding-cells = <0>;
            bindings = <&kp LS(SEMI)>, <&kp LS(EQUAL)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_fslh: u_fslh { /* / ) */
            compatible = "zmk,behavior-mod-morph";
            label = "u_FSLH";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp LS(N9)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        morph_colon: morph_colon { /* : */
            compatible = "zmk,behavior-mod-morph";
            label = "morph_COLON";
            #binding-cells = <0>;
            bindings = <&kp APOS>, <&kp APOS>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_enter: u_enter { /* ENTER " */
            compatible = "zmk,behavior-mod-morph";
            label = "u_ENTER";
            #binding-cells = <0>;
            bindings = <&kp ENTER>, <&kp LS(N2)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_dot: u_dot { /* . ' */
            compatible = "zmk,behavior-mod-morph";
            label = "u_DOT";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(N7)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_lpar: u_lpar { /* ( | */
            compatible = "zmk,behavior-mod-morph";
            label = "u_LPAR";
            #binding-cells = <0>;
            bindings = <&kp LS(N8)>, <&kp LS(INT_YEN)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        u_rpar: u_rpar { /* ) \ */
            compatible = "zmk,behavior-mod-morph";
            label = "u_RPAR";
            #binding-cells = <0>;
            bindings = <&kp LS(N9)>, <&kp INT_YEN>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp TAB      &kp Q &kp W &kp E &kp R &kp T &kp Y
                &morph_minus &kp A &kp S &kp D &kp F &kp G &kp H
                &kp LWIN     &kp Z &kp X &kp C &kp V &kp B &kp N
                    &lt 1 INT_MUHENKAN &mt LSHFT SPACE &mt LCTRL BSPC

                &kp DEL     &kp Y &kp U &kp I     &kp O   &kp P       &kp BSPC
                &morph_lbkt &kp H &kp J &kp K     &kp L   &morph_semi &kp ENTER
                &morph_rbkt &kp N &kp M &kp COMMA &kp DOT &kp FSLH    &kp RALT
                &mt RCTRL ENTER &mt RSHFT SPACE &lt 1 INT_HENKAN
            >;
        };

        num_layer {
            bindings = <
                &kp ESC &u_plus   &morph_n7 &morph_n8 &morph_n9 &u_fslh  &morph_colon
                &trans  &u_equal  &morph_n4 &morph_n5 &morph_n6 &u_enter &u_lpar
                &trans  &morph_n0 &morph_n1 &morph_n2 &morph_n3 &u_dot   &u_rpar
                    &lt 2 INT_MUHENKAN &trans &trans

                &kp DEL  &trans   &trans    &trans    &trans    &trans &trans
                &kp LBRC &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans &trans
                &kp RBRC &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans &trans
                &trans &trans &lt 2 INT_HENKAN
            >;
        };

        fn_layer {
            bindings = <
                &trans      &kp F1 &kp F2         &kp F3       &kp F4         &kp F5          &kp F6
                &trans      &none  &mmv MOVE_LEFT &mmv MOVE_UP &mmv MOVE_DOWN &mmv MOVE_RIGHT &none
                &bootloader &none  &mkp LCLK      &mkp MCLK    &mkp RCLK      &none           &none
                    &trans &trans &trans

                &kp F7 &kp F8     &kp F9          &kp F10      &kp F11          &kp F12   &trans
                &trans &kp C_MUTE &kp C_VOL_DN    &kp C_VOL_UP &kp C_PLAY_PAUSE &kp PSCRN &trans
                &none  &none      &kp LC(LA(INS)) &kp PSCRN    &none            &none     &bootloader
                &trans &trans &trans
            >;
        };
    };
};
